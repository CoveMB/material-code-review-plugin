{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/material-code-review/candidate-preflight.schema.json",
  "title": "Material Code Review candidate preflight receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_hash",
    "coverage_plan_hash",
    "lens_id",
    "route",
    "attempt",
    "draft_hash",
    "semantic_hash",
    "supersedes_receipt_hash",
    "verdict",
    "diagnostics",
    "reviewer_id",
    "independence_group",
    "review_mode",
    "fallback_assignment_hash",
    "degraded",
    "source_file",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "material-review/candidate-preflight/v1"
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "enum": ["primary", "fallback"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "supersedes_receipt_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": ["valid", "correctable", "rejected"]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message", "correctable"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correctable": {
            "type": "boolean"
          }
        }
      }
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "independence_group": {
      "type": "string",
      "minLength": 1
    },
    "review_mode": {
      "enum": ["subagent", "controller", "external"]
    },
    "fallback_assignment_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "degraded": {
      "type": "boolean"
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
