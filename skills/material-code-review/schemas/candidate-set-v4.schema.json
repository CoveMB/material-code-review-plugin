{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material-review/candidate-set/v4",
  "$defs": {
    "repositoryRelativeGitPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?![^\\u0000]*\\\\)(?![^\\u0000]*//)(?![^\\u0000]*/$)(?!\\.git(?:/|$))(?!\\.{1,2}(?:/|$))(?![^\\u0000]*/\\.{1,2}(?:/|$))(?![\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])(?![^\\u0000]*[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]$)(?![^\\u0000]*\\u0000)[^\\u0000]+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "finding": {
      "type": "object",
      "$comment": "Semantic invariant: line_end must be greater than or equal to line_start. Portable Draft 2020-12 structural validation cannot compare sibling values; the material-review controller enforces this invariant authoritatively during candidate ingestion.",
      "additionalProperties": false,
      "required": [
        "local_id",
        "title",
        "nature",
        "category",
        "severity",
        "confidence",
        "file",
        "line_start",
        "line_end",
        "evidence_side",
        "evidence_quote",
        "scope_relation",
        "related_changed_files",
        "direct_dependency",
        "observable_consequence",
        "trigger_conditions",
        "counterevidence_checked",
        "why_not_preference",
        "proposed_resolution",
        "estimated_fix_risk",
        "requires_user_decision",
        "assumptions"
      ],
      "properties": {
        "local_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "nature": {
          "enum": [
            "defect",
            "coverage_gap",
            "documentation_gap",
            "improvement",
            "risk"
          ]
        },
        "category": {
          "enum": [
            "correctness",
            "security",
            "privacy",
            "reliability",
            "tests",
            "docs",
            "performance",
            "api_contract",
            "migration",
            "concurrency",
            "simplification",
            "dry",
            "architecture",
            "standards"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "high",
            "medium",
            "low"
          ]
        },
        "confidence": {
          "enum": [
            "certain",
            "high",
            "medium",
            "low"
          ]
        },
        "file": {
          "$ref": "#/$defs/repositoryRelativeGitPath"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "description": "Inclusive first evidence line. The material-review controller requires line_end >= line_start."
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "description": "Inclusive final evidence line. Must be greater than or equal to line_start; this cross-field rule is enforced by the material-review controller."
        },
        "evidence_side": {
          "enum": [
            "comparison",
            "baseline",
            "diff"
          ]
        },
        "evidence_quote": {
          "type": "string",
          "minLength": 1
        },
        "scope_relation": {
          "enum": [
            "primary",
            "secondary",
            "pre_existing"
          ]
        },
        "related_changed_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryRelativeGitPath"
          }
        },
        "direct_dependency": {
          "type": "boolean"
        },
        "observable_consequence": {
          "type": "string",
          "minLength": 1
        },
        "trigger_conditions": {
          "type": "string",
          "minLength": 1
        },
        "counterevidence_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "why_not_preference": {
          "type": "string",
          "minLength": 1
        },
        "proposed_resolution": {
          "type": "string",
          "minLength": 1
        },
        "estimated_fix_risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "requires_user_decision": {
          "type": "boolean"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "low"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "blocker"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confidence": {
                "enum": [
                  "certain",
                  "high"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "counterevidence_checked": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_reviewed",
        "areas",
        "limitations"
      ],
      "properties": {
        "files_reviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryRelativeGitPath"
          }
        },
        "areas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_code",
        "outcome",
        "evidence",
        "finding_local_ids"
      ],
      "properties": {
        "check_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "outcome": {
          "enum": [
            "pass",
            "finding_emitted",
            "blocked"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_local_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "finding_local_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "finding_emitted"
              }
            }
          },
          "then": {
            "properties": {
              "finding_local_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "finding_local_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "specialistLens": {
      "enum": [
        "security_privacy",
        "reliability",
        "api_contract",
        "migration_deployment",
        "concurrency",
        "performance",
        "documentation",
        "architecture_simplification"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_hash",
    "coverage_plan_hash",
    "coverage_context_hash",
    "assignment_id",
    "assignment_kind",
    "lens_id",
    "reviewer_id",
    "independence_group",
    "review_mode",
    "check_results",
    "findings",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "material-review/candidate-set/v4"
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage_context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "assignment_kind": {
      "enum": [
        "core",
        "obligation",
        "supplemental",
        "specialist"
      ]
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "lens_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "independence_group": {
      "type": "string",
      "minLength": 1
    },
    "review_mode": {
      "enum": [
        "subagent",
        "controller",
        "external"
      ]
    },
    "check_results": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "primary_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryRelativeGitPath"
      },
      "minItems": 1
    },
    "context_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryRelativeGitPath"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assignment_kind": {
            "const": "obligation"
          }
        }
      },
      "then": {
        "required": [
          "obligation_id"
        ],
        "properties": {
          "check_results": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "obligation_id"
          ]
        },
        "properties": {
          "check_results": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assignment_kind": {
            "const": "specialist"
          }
        },
        "required": [
          "assignment_kind"
        ]
      },
      "then": {
        "required": [
          "unit_ids",
          "primary_paths",
          "context_paths"
        ],
        "properties": {
          "lens_id": {
            "$ref": "#/$defs/specialistLens"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "unit_ids"
              ]
            },
            {
              "required": [
                "primary_paths"
              ]
            },
            {
              "required": [
                "context_paths"
              ]
            }
          ]
        }
      }
    }
  ],
  "title": "Material-review assignment candidate set v4"
}
