{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/demo/candidate-set.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_path"],
  "properties": {
    "evidence_path": {
      "$ref": "#/$defs/repositoryRelativeGitPath"
    }
  },
  "$defs": {
    "repositoryRelativeGitPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    }
  }
}
