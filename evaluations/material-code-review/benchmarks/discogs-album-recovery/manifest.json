{
  "schema": "material-review-evaluation/benchmark/v1",
  "benchmark_id": "discogs-album-recovery",
  "target_repository": "https://github.com/CoveMB/discogs-collection.git",
  "baseline_sha": "4e59c674dae10a4edcb8952818364c6faa255389",
  "comparison_sha": "42a74b8619054800eca8502d8a687d3c98102565",
  "require_immediate_parent": true,
  "review_mode": "range",
  "posture": "immutable",
  "include_untracked": false,
  "dependency_installation_commands": [
    {
      "argv": [
        "npm",
        "ci",
        "--ignore-scripts"
      ],
      "working_directory": ".",
      "timeout_seconds": 300
    }
  ],
  "baseline_validation_commands": [
    {
      "argv": [
        "python3",
        "scripts/dev_checks.py",
        "--all"
      ],
      "working_directory": ".",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "python3",
        "-m",
        "compileall",
        "-q",
        "scripts",
        "tests"
      ],
      "working_directory": ".",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "working_directory": ".",
      "timeout_seconds": 180
    },
    {
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "working_directory": ".",
      "timeout_seconds": 300
    }
  ],
  "required_lenses": [
    "correctness",
    "data_integrity",
    "state_and_cache_lifecycle",
    "authority_boundaries",
    "causal_evidence",
    "negative_controls",
    "repair_safety"
  ],
  "prohibitions": [
    "oracle_lookup",
    "repair",
    "live_spotify_calls",
    "private_discogs_data",
    "publication",
    "source_egress",
    "prior_run_discovery"
  ],
  "trial_policy": {
    "initial_trials": 2,
    "conditional_third": true
  },
  "gate_policy": {
    "gate_a": "approve_all_retained_for_planning",
    "gate_b": "approve_validated_plan_no_repair"
  },
  "required_artifacts": [
    "trial/native-controller-artifacts",
    "trial/command-log.json",
    "trial/validation.json",
    "trial/limitations.json",
    "trial/target-cleanliness.json",
    "trial/no-repair-attestation.json",
    "agreement/agreement.json",
    "comparison/judgment.json"
  ],
  "default_timeout_seconds": 900,
  "infrastructure_retry_limit": 1,
  "executor_isolation_policy": {
    "allowed_modes": [
      "filesystem_blinding",
      "logical_blinding"
    ],
    "exposed_roots": [
      "trial_workflow",
      "target",
      "trial_output"
    ],
    "fresh_agent_context": true,
    "fresh_target_clone": true
  },
  "file_hashes": {
    "review_request_sha256": "18bb0bbd8b5d42cff488245d1b233602fcc8b2962f923294e6737cb063c73935",
    "judge_oracle_sha256": "56ed2743188d5ca3ee2bb833fe5c4b5dc383a3e2f3d877eaec20b84456a2162d",
    "judge_rubric_sha256": "aa7c869a8742ba587d001f7b273666081b3cae06a27f0a28ad4820b476d11cf6"
  }
}
